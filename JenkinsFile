pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'source code checkout completed'
            }
        }
        stage('Build') {
            steps {
                bat 'mvn clean compile'
            }
        }
        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }
        stage('Package Artifacts') {
            steps {
                bat 'mvn package'
            }
        }
    }
}
