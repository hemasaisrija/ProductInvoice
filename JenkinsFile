pipeline {
agent any
stages {
    stage('Checkout') {
        steps {
            echo 'Fetching source code'
        }
    }

    stage('Build') {
        steps {
            echo 'Building the application'
            bat 'mvn clean compile'
        }
    }

    stage('Test') {
        steps {
            echo 'Running tests'
            bat 'mvn test'
        }
    }

    stage('Archive Artifacts') {
        steps {
            echo 'Archiving build artifacts'
            bat 'mvn package'
        }
    }
}
}

